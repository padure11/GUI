.lc-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
}

.lc-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
}

.lc-panel {
    width: 480px;
    padding: 32px;
    background-color: rgb(26, 29, 35);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(255, 107, 44);
    align-items: center;
}

.lc-title {
    color: rgb(255, 107, 44);
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 8px;
}

.lc-subtitle {
    color: rgb(180, 190, 200);
    font-size: 14px;
    -unity-font-style: italic;
    margin-bottom: 24px;
}

.lc-buttons {
    flex-direction: row;
    justify-content: center;
}

.lc-button {
    height: 52px;
    min-width: 160px;
    margin-left: 8px;
    margin-right: 8px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: rgb(36, 40, 48);
    border-radius: 8px;
    border-width: 0;
    color: rgb(220, 225, 232);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.lc-button:hover {
    background-color: rgb(56, 60, 70);
}

.lc-button:disabled {
    opacity: 0.4;
}

.lc-button-primary {
    background-color: rgb(255, 107, 44);
    color: rgb(255, 255, 255);
}

.lc-button-primary:hover {
    background-color: rgb(255, 138, 80);
}

.lc-button-primary:disabled {
    background-color: rgb(100, 60, 40);
    opacity: 0.5;
}

.lc-waiting {
    color: rgb(120, 130, 145);
    font-size: 12px;
    -unity-font-style: italic;
    margin-top: 16px;
    display: none;
}
