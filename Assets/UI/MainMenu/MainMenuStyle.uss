.menu-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(20, 22, 28);
    align-items: center;
    justify-content: center;
}

.title {
    font-size: 64px;
    color: rgb(74, 158, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    letter-spacing: 6px;
}

.subtitle {
    font-size: 22px;
    color: rgb(180, 180, 200);
    -unity-text-align: middle-center;
    margin-bottom: 40px;
    letter-spacing: 2px;
}

.button-stack {
    width: 320px;
    align-items: stretch;
    justify-content: center;
}

.menu-button {
    height: 56px;
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 20px;
    color: rgb(240, 240, 240);
    background-color: rgb(40, 44, 56);
    border-color: rgb(74, 158, 255);
    border-width: 2px;
    border-radius: 6px;
    -unity-font-style: bold;
}

.menu-button:hover {
    background-color: rgb(74, 158, 255);
    color: rgb(20, 22, 28);
}

.menu-button:disabled {
    opacity: 0.45;
}

.menu-button-danger {
    border-color: rgb(220, 80, 80);
}

.menu-button-danger:hover {
    background-color: rgb(220, 80, 80);
    color: rgb(255, 255, 255);
}

.join-input {
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 18px;
    height: 48px;
}

.join-input > .unity-base-field__label {
    color: rgb(200, 200, 220);
    min-width: 100px;
    font-size: 16px;
}

.join-input > .unity-base-text-field__input {
    background-color: rgb(30, 32, 40);
    color: rgb(240, 240, 240);
    border-color: rgb(74, 158, 255);
    border-width: 1px;
    border-radius: 4px;
    padding-left: 8px;
}

.code-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
}

.join-code-display {
    font-size: 22px;
    color: rgb(120, 220, 140);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.copy-button {
    height: 32px;
    width: 80px;
    margin-left: 12px;
    font-size: 14px;
    color: rgb(240, 240, 240);
    background-color: rgb(40, 44, 56);
    border-color: rgb(74, 158, 255);
    border-width: 1px;
    border-radius: 4px;
    display: none;
}

.copy-button:hover {
    background-color: rgb(74, 158, 255);
    color: rgb(20, 22, 28);
}

.status {
    margin-top: 12px;
    font-size: 14px;
    color: rgb(180, 180, 200);
    -unity-text-align: middle-center;
}

.mm-settings-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(10, 12, 16, 0.75);
    align-items: center;
    justify-content: center;
    display: none;
}

.mm-settings-panel {
    width: 360px;
    padding: 24px;
    background-color: rgb(26, 29, 35);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(74, 158, 255);
    align-items: stretch;
}

.mm-settings-title {
    color: rgb(255, 107, 44);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 6px;
    margin-bottom: 20px;
}

.mm-volume-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 8px;
}

.mm-volume-label {
    width: 60px;
    color: rgb(200, 210, 220);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.mm-slider {
    flex-grow: 1;
}
